# Salin menjadi .env lalu sesuaikan. Nilai di bawah sama dengan bawaan config.py.

SECRET_KEY=ganti-dengan-string-acak-panjang
# Zona waktu untuk tampilan jam/tanggal (DB tetap menyimpan UTC).
ZONA_WAKTU=Asia/Jakarta

# ---------- mode kerja ----------
# real | mock
SERIAL_MODE=mock
CAMERA_MODE=mock

# ---------- serial ----------
SERIAL_PORT=COM21
SERIAL_BAUD=115200
# Dipakai kalau SERIAL_PORT tidak ada: cari perangkat dengan VID ini (CH340)
SERIAL_AUTODETECT_VID=1A86

# ---------- kamera ----------
# Cari kamera dari namanya (lebih stabil daripada index yang bisa bergeser
# saat DroidCam/OBS aktif). Kosongkan untuk memakai CAMERA_INDEX.
CAMERA_NAMA=
# Dipakai hanya kalau CAMERA_NAMA kosong.
CAMERA_INDEX=0
CAMERA_LEBAR=1280
CAMERA_TINGGI=720

# ---------- model ----------
# SVM_MODEL_PATH=models/model_svm_epoch.pkl
SVM_MIN_MARGIN=0.30

# ---------- pencocokan ----------
RESI_JARAK_MAKS=2
NAMA_MIN_RASIO=85
NAMA_AMBIGU_GAP=5

# ---------- state machine ----------
TENANG_MS=1500
BATAS_TOLAK=3
PINTU_TERBUKA_MAKS_S=120
AUTO_UNLOCK_MAKS_PER_JAM=3
# true untuk kunci pegas/fail-secure (kait selalu terkunci saat solenoid mati)
KUNCI_FAIL_SECURE=false
UNLOCK_MS=3000
TOMBOL_JEDA_S=5

# ---------- OTP ----------
OTP_PANJANG=6
OTP_MENIT=30
OTP_MAKS_PERCOBAAN=5

# ---------- Telegram (kosong = mode log saja) ----------
TELEGRAM_TOKEN=
TELEGRAM_CHAT_ADMIN=
